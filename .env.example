# Township Guardian AI — Environment Configuration Example
# Copy to .env and adjust as necessary.

# Application General
TG_APP_NAME="Township Guardian AI"
# Operating mode: "simulation" or "video_analysis" (both share the identical prioritization engine)
TG_APP_MODE="simulation"
TG_DATABASE_URL="sqlite:///./data/township_guardian.db"
TG_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
TG_SEED_DEMO_HISTORY=true
TG_DEMO_ADMIN_NAME="Demo Administrator"
TG_ALLOW_DEMO_ENDPOINTS=true

# Prioritization Scoring Formula (Provisional Prototype Assumptions)
# priority_score = 0.40 * sev + 0.25 * imm + 0.20 * people + 0.15 * secondary
TG_WEIGHT_SEVERITY=0.40
TG_WEIGHT_IMMEDIACY=0.25
TG_WEIGHT_PEOPLE_AT_RISK=0.20
TG_WEIGHT_SECONDARY_HAZARD=0.15

# Priority Level Thresholds
TG_THRESHOLD_CRITICAL=80.0
TG_THRESHOLD_HIGH=60.0
TG_THRESHOLD_MEDIUM=35.0
TG_LOW_CONFIDENCE_THRESHOLD=0.5

# Queue Hysteresis & Deduplication
TG_RANK_HYSTERESIS=2.0
TG_DEDUP_WINDOW_SECONDS=300

# Video Processing & Computer Vision
TG_MAX_UPLOAD_MB=100
TG_MAX_VIDEO_SECONDS=120
TG_FRAME_SAMPLE_INTERVAL_SECONDS=1.0
TG_PROCESSING_TIMEOUT_SECONDS=300
# Detector: "auto", "hog_posture", "yolox_posture", or "none" (explicit unavailable state)
TG_DETECTOR="auto"
TG_RETAIN_UPLOADS_HOURS=24
